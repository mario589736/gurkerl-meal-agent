{
  "mcpServers": {
    "gurkerl": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.gurkerl.at/mcp/",
        "--header",
        "rhl-email: ${RHL_EMAIL}",
        "--header",
        "rhl-pass: ${RHL_PASS}"
      ],
      "env": {
        "RHL_EMAIL": "your-email@example.com",
        "RHL_PASS": "your-password"
      }
    }
  }
}
